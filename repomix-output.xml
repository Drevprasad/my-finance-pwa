<file path="components/InvestmentsPanel.tsx">
import { Card, CardTitle } from '@/components/ui';
import { formatINR } from '@/lib/money';
import type { BalanceRow } from '@/lib/types';

export default function InvestmentsPanel({ rows }: { rows: BalanceRow[] | null }) {
  const list = rows ?? [];
  const total = list.reduce((s, r) => s + r.balance_minor, 0);
  const groups: { title: string; items: BalanceRow[] }[] = [
    { title: 'Investments', items: list.filter(r => r.subtype === 'investment') },
    { title: 'Fixed deposits', items: list.filter(r => r.subtype === 'fd') },
  ];

  return (
    <Card>
      <CardTitle right={<span className="tabular text-sm font-bold text-blue-300">{formatINR(total)}</span>}>
        Investments
      </CardTitle>
      <p className="-mt-2 mb-3 text-[11px] text-gray-500">
        Current balances (cost basis, not market value). Transfers into these accounts are never counted as expenses.
      </p>

      {rows === null ? (
        <div className="py-6 text-center text-sm text-gray-500">Loading…</div>
      ) : list.length === 0 ? (
        <div className="py-6 text-center text-sm text-gray-500">
          No investment / FD accounts yet.
        </div>
      ) : (
        <div className="space-y-4">
          {groups.filter(g => g.items.length).map(g => (
            <div key={g.title}>
              <div className="mb-1.5 flex items-center justify-between text-xs text-gray-400">
                <span>{g.title}</span>
                <span className="tabular">{formatINR(g.items.reduce((s, r) => s + r.balance_minor, 0))}</span>
              </div>
              <ul className="space-y-1.5">
                {g.items.map(r => (
                  <li key={r.id}
                      className="flex items-center justify-between gap-2 rounded border border-gray-800 bg-gray-900 px-3 py-2 text-sm">
                    <span className="min-w-0 truncate text-gray-200">{r.name}</span>
                    <span className="tabular shrink-0 font-semibold text-white">{formatINR(r.balance_minor)}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      )}
    </Card>
  );
}
