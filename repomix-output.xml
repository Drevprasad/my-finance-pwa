'use client';

import { useCallback, useEffect, useState } from 'react';
import { supabase } from '@/lib/supabase';
import { parseBankCsv, type ParseReport } from '@/lib/csv';

interface Acc { id: number; name: string; type: string }
interface ImportResult { batch_id: number | null; inserted: number; skipped: number; failed: { row: number; reason: string }[] }

export default function CsvImport({ onImported }: { onImported?: () => void }) {
  const [accounts, setAccounts] = useState<Acc[]>([]);
  const [accountId, setAccountId] = useState('');
  const [report, setReport] = useState<ParseReport | null>(null);
  const [result, setResult] = useState<ImportResult | null>(null);
  const [busy, setBusy] = useState(false);
  const [error, setError] = useState<string | null>(null);

  useEffect(() => {
    let alive = true;
    void supabase
      .from('accounts')
      .select('id,name,type')
      .eq('is_active', true)
      .order('name')
      .then(({ data, error: err }) => {
        if (!alive) return;
        if (err) { setError(err.message); return; }
        const rows = ((data ?? []) as Acc[]).filter(a => a.type !== 'income' && a.type !== 'expense');
        setAccounts(rows);
        if (rows.length) setAccountId(prev => prev || String(rows[0].id));
      });
    return () => { alive = false; };
  }, []);

  const onFile = useCallback(async (e: React.ChangeEvent<HTMLInputElement>) => {
    const file = e.target.files?.[0];
    e.target.value = '';
    if (!file) return;

    setResult(null); setReport(null); setError(null);

    try {
      if (!accountId) throw new Error('Choose the target account first.');

      const parsed = await parseBankCsv(file);
      setReport(parsed);

      if (!parsed.rows.length) {
        setError('No importable rows. See the parse failures below.');
        return;
      }

      setBusy(true);
      const { data, error: rpcErr } = await supabase.rpc('import_statement', {
        p_account_id: Number(accountId),
        p_rows: parsed.rows,
        p_file_name: file.name,
        p_source_type: 'csv',
      });
      if (rpcErr) throw new Error(rpcErr.message);
      setResult(data as ImportResult);
      onImported?.();
    } catch (err) {
      setError(err instanceof Error ? err.message : String(err));
    } finally {
      setBusy(false);
    }
  }, [accountId, onImported]);

  return (
    <div className="flex h-fit flex-col gap-3 rounded-xl border border-dashed border-gray-700 bg-gray-800 p-6 shadow-lg">
      <h2 className="text-xl font-bold">Bulk import bank CSV</h2>

      <div>
        <label htmlFor="csv-account" className="mb-1 block text-sm font-semibold text-gray-300">
          Importing into
        </label>
        <select
          id="csv-account"
          value={accountId}
          onChange={e => setAccountId(e.target.value)}
          className="w-full rounded border border-gray-600 bg-gray-900 p-2 text-white"
        >
          {accounts.map(a => <option key={a.id} value={a.id}>{a.name}</option>)}
          {accounts.length === 0 && <option value="">No accounts</option>}
        </select>
      </div>

      <label className="block w-full cursor-pointer rounded bg-blue-600 px-4 py-2 text-center text-sm font-semibold text-white hover:bg-blue-500">
        {busy ? 'Importing…' : 'Choose CSV file'}
        <input type="file" accept=".csv,text/csv" className="sr-only" onChange={onFile} disabled={busy} />
      </label>

      <p className="text-xs leading-relaxed text-gray-400">
        Header row is detected automatically (date + amount / withdrawal + deposit). Duplicates are
        checked in the database; every rejected row is listed with a reason.
      </p>

      {error && (
        <div role="alert" className="rounded border border-red-800 bg-red-950/50 p-3 text-sm text-red-300">
          {error}
        </div>
      )}

      {report && (
        <p className="text-xs text-gray-400">
          Parsed {report.rows.length} row(s), {report.failed.length} unreadable in the browser.
        </p>
      )}

      {report && report.failed.length > 0 && (
        <ul className="max-h-32 space-y-1 overflow-y-auto text-xs text-red-300">
          {report.failed.slice(0, 10).map(f => (
            <li key={f.row}>row {f.row}: {f.reason}</li>
          ))}
        </ul>
      )}

      {result && (
        <div className="space-y-1 text-sm">
          <p className="text-emerald-400">Inserted {result.inserted}</p>
          <p className="text-gray-400">Skipped duplicates {result.skipped}</p>
          <p className={result.failed.length ? 'text-red-400' : 'text-gray-400'}>
            Rejected {result.failed.length}
          </p>
          <ul className="max-h-32 space-y-1 overflow-y-auto text-xs text-red-300">
            {result.failed.slice(0, 10).map(f => (
              <li key={f.row}>row {f.row}: {f.reason}</li>
            ))}
          </ul>
        </div>
      )}
    </div>
  );
}
</file>

